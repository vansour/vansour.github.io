---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '个人导航页' } = Astro.props;

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '首页' },
  { href: '/mirrors/', label: '国内镜像源' },
];

// 分段安全：只匹配该段本身或其子路径。
// 单纯 startsWith 会让 /mirrors-old/ 被误判为「国内镜像源」当前页。
const isCurrent = (href: string) => {
  if (href === '/') return path === '/';
  const prefix = href.endsWith('/') ? href : `${href}/`;
  return path === href || path.startsWith(prefix);
};
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class="band">
      <div class="wrap band__inner">
        <a class="band__brand" href="/">vansour</a>
        <nav class="band__nav">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <div class="wrap page">
      <slot />
    </div>

    <footer class="wrap foot">
      数据均标注核实日期。镜像站状态会变，动手前请以镜像站官方文档为准。
    </footer>

    {/* 复制成功与失败都经此提示。aria-live 让屏幕阅读器也能听到 */}
    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script>
      /* ---------------------------------------------------------------- *
       * 复制
       * ---------------------------------------------------------------- */

      // 同步兜底：Clipboard API 不可用时用隐藏 textarea + execCommand。
      // 注意 execCommand 有布尔返回值，不能假定它成功——参考站就是没查，
      // 导致成功与失败都提示「已复制」。
      function copyViaTextarea(text: string): boolean {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        document.body.removeChild(ta);
        return ok;
      }

      let toastTimer: number | undefined;

      function toast(message: string, kind: 'ok' | 'err'): void {
        const el = document.getElementById('toast');
        if (!el) return;
        el.textContent = message;
        el.dataset.kind = kind;
        el.classList.add('show');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => el.classList.remove('show'), 1800);
      }

      document.addEventListener('click', async (event) => {
        const button = (event.target as Element | null)?.closest<HTMLButtonElement>(
          '[data-copy-target]',
        );
        if (!button) return;

        const target = document.getElementById(button.dataset.copyTarget ?? '');
        if (!target) return;

        const text = target.textContent ?? '';
        let ok = false;

        if (navigator.clipboard?.writeText) {
          try {
            await navigator.clipboard.writeText(text);
            ok = true;
          } catch {
            ok = copyViaTextarea(text);
          }
        } else {
          ok = copyViaTextarea(text);
        }

        toast(ok ? '已复制' : '复制失败，请手动选中命令', ok ? 'ok' : 'err');
      });

      /* ---------------------------------------------------------------- *
       * 版本 / 来源切换（两个原生 select + 面板）
       * 「版本 × 源」的所有面板都已在 HTML 里，这里只切 hidden，
       * 不做运行期字符串替换——显示的命令必须与构建产物逐字一致。
       * 无 JS 时靠页面里的 <noscript> 放开全部面板并隐藏下拉。
       * ---------------------------------------------------------------- */

      const versionSel = document.querySelector<HTMLSelectElement>('[data-version-select]');
      const sourceSel = document.querySelector<HTMLSelectElement>('[data-source-select]');

      if (sourceSel) {
        const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
        // 打开页面时的默认项（SSR 里被标了 selected 的那两个）——坏 hash 回退到这里。
        // 不能用 options[0]：来源下拉按 region 分组，第一项是「官方」组里的源，
        // 那样一个打错的 hash 会把人静默换到官方源（国内通常最慢的那个）上去
        const defaultVersion = versionSel?.value ?? '';
        const defaultSource = sourceSel.value;

        const render = (): void => {
          const version = versionSel?.value ?? '';
          const slug = sourceSel.value;
          for (const panel of panels) {
            // 无版本的工具没有版本下拉，面板上可能连 data-version 都没有
            panel.hidden = !((panel.dataset.version ?? '') === version && panel.dataset.slug === slug);
          }
        };

        /** 认得的值就用它，不认识退回页面默认值——坏 hash 不该让来源随机停在别处 */
        const setOrReset = (sel: HTMLSelectElement | null, value: string, fallback: string): void => {
          if (!sel) return;
          const known = Array.from(sel.options).some((o) => o.value === value);
          sel.value = known ? value : fallback;
        };

        /** 深链：#<版本key>/<源slug>；无版本的工具是 #<源slug> */
        const applyHash = (): void => {
          const hash = decodeURIComponent(location.hash.slice(1));
          if (!hash) return;
          const [first, second] = hash.split('/');
          const hasVersion = second !== undefined;
          if (hasVersion) setOrReset(versionSel, first, defaultVersion);
          setOrReset(sourceSel, hasVersion ? second : first, defaultSource);
          render();
        };

        const onChange = (): void => {
          render();
          const parts = [versionSel?.value ?? '', sourceSel.value].filter(Boolean);
          history.replaceState(null, '', `#${parts.join('/')}`);
        };

        versionSel?.addEventListener('change', onChange);
        sourceSel.addEventListener('change', onChange);
        window.addEventListener('hashchange', applyHash);

        applyHash();
      }
    </script>
  </body>
</html>

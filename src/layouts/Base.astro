---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { boards } from '../data/index';
import { isSection } from '../lib/nav';

interface Props {
  title: string;
  description?: string;
  /**
   * 内容列放开到外壳宽度（80rem）。只给首页那种卡片网格用；
   * 工具页一律压在 60rem——**包括没有侧栏的**（如 /dns/），
   * 否则「外壳变宽、正文本宽不变」就不成立了，命令的折行会跟着板块变。
   */
  wide?: boolean;
}

const { title, description = '个人导航页', wide = false } = Astro.props;

const path = Astro.url.pathname;
// 顶栏就是「各板块 + 首页」，板块清单在数据层，加一个板块不用改这里
const nav = [{ href: '/', label: '首页' }, ...boards.map((b) => ({ href: b.href, label: b.name }))];

// 目录只在镜像源板块出现——首页是入口页，没有目录可列
const withSidebar = isSection(path, '/mirrors/');

// 顶栏的「国内镜像源」在工具页也要亮：这里要的是「本段及其子路径」，不是「只匹配本页」
const sectionCurrent = (href: string) => (isSection(path, href) ? 'page' : undefined);
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {/* 移动端浏览器把顶栏底色刷到地址栏上；手动选了主题的人会与系统偏好不一致，接受 */}
    <meta name="theme-color" content="#1c7aa8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#103449" media="(prefers-color-scheme: dark)" />
    {/* 主题必须在首帧前落定，否则会先闪一帧亮色。所以这段是内联的，不进打包 */}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {
        /* 隐私模式下 localStorage 会抛异常，忽略即可——退化成跟随系统 */
      }
    </script>
  </head>

  <body class="min-h-dvh bg-ground text-ink">
    {/* 侧栏一上，键盘用户要先过十几条链接才能到正文 */}
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-ctl focus:bg-surface focus:px-3 focus:py-1.5 focus:text-ink focus:shadow-card"
      >跳到内容</a
    >

    <header class="bg-band sm:sticky sm:top-0 sm:z-30">
      <div
        class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 py-2.5 sm:h-(--band-h) sm:flex-nowrap sm:py-0"
      >
        <a
          href="/"
          class="text-[1.05rem] font-semibold tracking-tight text-inverse hover:underline"
          >vansour</a
        >

        <nav class="flex items-center gap-3 text-[0.88rem] sm:gap-4" aria-label="站点">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={sectionCurrent(item.href)}
                class="border-b-2 border-transparent py-0.5 text-inverse hover:underline aria-[current=page]:border-inverse aria-[current=page]:hover:no-underline"
              >
                {item.label}
              </a>
            ))
          }

          {/* 原生 select，与版本/来源两个下拉同一套做法。底色用内容面而不是透明：
              透明会让展开的选项列表在白底上显示成白字 */}
          <label class="flex items-center">
            <span class="sr-only">主题</span>
            <select
              data-theme-select
              class="cursor-pointer rounded-ctl border border-line bg-surface px-1.5 py-0.5 text-[0.78rem] text-ink hover:border-sky"
            >
              <option value="system" selected>跟随系统</option>
              <option value="light">浅色</option>
              <option value="dark">深色</option>
            </select>
          </label>
        </nav>
      </div>
    </header>

    <div class="mx-auto flex max-w-page flex-col px-5 lg:flex-row lg:gap-10">
      {
        withSidebar && (
          <details class="mt-4 rounded-card border border-line bg-surface lg:hidden">
            <summary class="cursor-pointer px-4 py-2.5 text-[0.9rem] font-semibold">目录</summary>
            <div class="border-t border-line px-3 py-3">
              <Sidebar />
            </div>
          </details>
        )
      }

      {
        withSidebar && (
          <aside class="hidden w-64 shrink-0 lg:block">
            {/* 只吸在顶栏下面，不吸到视口顶部；自身可滚，长目录不会把页面顶长 */}
            <div class="sticky top-(--band-h) max-h-[calc(100dvh-var(--band-h)-1.5rem)] overflow-y-auto overscroll-contain py-6">
              <Sidebar />
            </div>
          </aside>
        )
      }

      {/* min-w-0 是硬要求：多行命令块会横向滚动，没有它整行会被撑宽、页面出横向滚动条 */}
      <main
        id="content"
        class:list={['min-w-0 flex-1', wide ? 'py-8 sm:py-10' : 'max-w-content py-6 sm:py-8']}
      >
        <slot />
      </main>
    </div>

    {/* 复制成功与失败都经此提示。aria-live 让屏幕阅读器也能听到。
        显隐用 data-show 属性而不是类名，省得为它单留一条组件样式 */}
    <div
      id="toast"
      class="pointer-events-none fixed bottom-8 left-1/2 z-50 -translate-x-1/2 translate-y-2 rounded-full bg-band px-4 py-2 text-[0.83rem] font-semibold whitespace-nowrap text-inverse opacity-0 transition duration-200 data-show:translate-y-0 data-show:opacity-100 data-[kind=err]:bg-danger data-[kind=err]:text-on-danger"
      role="status"
      aria-live="polite"></div>

    <script>
      /* ---------------------------------------------------------------- *
       * 复制
       * ---------------------------------------------------------------- */

      // 同步兜底：Clipboard API 不可用时用隐藏 textarea + execCommand。
      // 注意 execCommand 有布尔返回值，不能假定它成功——参考站就是没查，
      // 导致成功与失败都提示「已复制」。
      function copyViaTextarea(text: string): boolean {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        document.body.removeChild(ta);
        return ok;
      }

      let toastTimer: number | undefined;

      function toast(message: string, kind: 'ok' | 'err'): void {
        const el = document.getElementById('toast');
        if (!el) return;
        el.textContent = message;
        el.dataset.kind = kind;
        el.toggleAttribute('data-show', true);
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => el.toggleAttribute('data-show', false), 1800);
      }

      document.addEventListener('click', async (event) => {
        const button = (event.target as Element | null)?.closest<HTMLButtonElement>(
          '[data-copy-target]',
        );
        if (!button) return;

        const target = document.getElementById(button.dataset.copyTarget ?? '');
        if (!target) return;

        const text = target.textContent ?? '';
        let ok = false;

        if (navigator.clipboard?.writeText) {
          try {
            await navigator.clipboard.writeText(text);
            ok = true;
          } catch {
            ok = copyViaTextarea(text);
          }
        } else {
          ok = copyViaTextarea(text);
        }

        toast(ok ? '已复制' : '复制失败，请手动选中命令', ok ? 'ok' : 'err');
      });

      /* ---------------------------------------------------------------- *
       * 版本 / 来源切换（两个原生 select + 面板）
       * 「版本 × 源」的所有面板都已在 HTML 里，这里只切 hidden，
       * 不做运行期字符串替换——显示的命令必须与构建产物逐字一致。
       * 无 JS 时靠页面里的 <noscript> 放开全部面板并隐藏下拉。
       * ---------------------------------------------------------------- */

      const versionSel = document.querySelector<HTMLSelectElement>('[data-version-select]');
      const sourceSel = document.querySelector<HTMLSelectElement>('[data-source-select]');

      if (sourceSel) {
        const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
        // 打开页面时的默认项（SSR 里被标了 selected 的那两个）——坏 hash 回退到这里。
        // 不能用 options[0]：来源下拉按 region 分组，第一项是「官方」组里的源，
        // 那样一个打错的 hash 会把人静默换到官方源（国内通常最慢的那个）上去
        const defaultVersion = versionSel?.value ?? '';
        const defaultSource = sourceSel.value;

        const render = (): void => {
          // null = 本页没有版本下拉：没有版本维度的工具（pip、DNS）与只有一个版本的工具
          // 都是这样。**不能拿空串去比 data-version**——后者面板上写着版本号，
          // 一比就全判成不匹配，一打开带 hash 的链接或动一下来源，整页命令块全被藏起来
          const version = versionSel?.value ?? null;
          const slug = sourceSel.value;
          for (const panel of panels) {
            const sameVersion = version === null || (panel.dataset.version ?? '') === version;
            panel.hidden = !(sameVersion && panel.dataset.slug === slug);
          }
        };

        /** 认得的值就用它，不认识退回页面默认值——坏 hash 不该让来源随机停在别处 */
        const setOrReset = (sel: HTMLSelectElement | null, value: string, fallback: string): void => {
          if (!sel) return;
          const known = Array.from(sel.options).some((o) => o.value === value);
          sel.value = known ? value : fallback;
        };

        /** 深链：#<版本key>/<源slug>；无版本的工具是 #<源slug> */
        const applyHash = (): void => {
          // 坏转义（如 #%zz）会让 decodeURIComponent 抛异常，而这个异常会把本模块
          // 剩下的代码一起带走（包括后面的主题切换）。认不出来就当没有 hash
          let hash: string;
          try {
            hash = decodeURIComponent(location.hash.slice(1));
          } catch {
            hash = '';
          }
          if (!hash) return;
          const [first, second] = hash.split('/');
          const hasVersion = second !== undefined;
          if (hasVersion) setOrReset(versionSel, first, defaultVersion);
          setOrReset(sourceSel, hasVersion ? second : first, defaultSource);
          render();
        };

        const onChange = (): void => {
          render();
          const parts = [versionSel?.value ?? '', sourceSel.value].filter(Boolean);
          history.replaceState(null, '', `#${parts.join('/')}`);
        };

        versionSel?.addEventListener('change', onChange);
        sourceSel.addEventListener('change', onChange);
        window.addEventListener('hashchange', applyHash);

        applyHash();
      }

      /* ---------------------------------------------------------------- *
       * 主题三态
       * 亮暗的色值切换全在 CSS 那边（light-dark() 认 color-scheme），
       * 这里只负责把选择落到 documentElement 与 localStorage 上。
       * 首帧之前那一步在 <head> 的内联脚本里，这段只管之后的切换与回填。
       * ---------------------------------------------------------------- */

      const themeSel = document.querySelector<HTMLSelectElement>('[data-theme-select]');

      if (themeSel) {
        let stored: string | null = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          stored = null;
        }
        // SSR 里默认选中的是「跟随系统」，与实际存的选择同步一次
        themeSel.value = stored === 'light' || stored === 'dark' ? stored : 'system';

        themeSel.addEventListener('change', () => {
          const value = themeSel.value;
          if (value === 'system') {
            document.documentElement.removeAttribute('data-theme');
          } else {
            document.documentElement.dataset.theme = value;
          }
          try {
            localStorage.setItem('theme', value);
          } catch {
            /* 存不了就只作用于本次会话 */
          }
        });
      }
    </script>
  </body>
</html>

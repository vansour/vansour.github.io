---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import CopyCodeButton from '../components/CopyCodeButton.astro';
import CodeTabs from '../components/CodeTabs.astro';

interface Props {
  title?: string;
  description?: string;
}

const siteTitle = 'Vansour Blog';
const { title = siteTitle, description } = Astro.props;
const pageTitle = title === siteTitle ? siteTitle : `${title} · ${siteTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- MiSans 字体（自托管，unicode-range 分片按需加载；字重映射 330/520/630） -->
    <link rel="stylesheet" href="/fonts/misans/MiSans-Regular.min.css" />
    <link rel="stylesheet" href="/fonts/misans/MiSans-Semibold.min.css" />
    <link rel="stylesheet" href="/fonts/misans/MiSans-Bold.min.css" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // 防闪烁：首帧渲染前读取主题偏好（本地存储 > 系统设置 > 默认浅色）与强调色
      (function () {
        const root = document.documentElement;
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme =
          stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
        const ACCENTS = ['blue', 'green', 'purple', 'red', 'orange', 'cyan', 'pink', 'gray'];
        const accent = ACCENTS.includes(localStorage.getItem('accent'))
          ? localStorage.getItem('accent')
          : 'blue';
        root.dataset.theme = theme;
        root.dataset.accent = accent;
      })();
    </script>
  </head>
  <body>
    <Header />
    <!-- data-pagefind-body：搜索只索引正文区域，排除导航/页脚 -->
    <main class="container" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <SearchDialog />
    <CopyCodeButton />
    <CodeTabs />
  </body>
</html>

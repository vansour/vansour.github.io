---
import Base from '../layouts/Base.astro';
import ToolBlock from '../components/ToolBlock.astro';
import { docs, byCategory, CATEGORY_LABEL, latestVerified } from '../data/index';
import { CATEGORY } from '../data/schema';

const sections = CATEGORY.map((key) => ({
  key,
  label: CATEGORY_LABEL[key],
  items: byCategory.get(key) ?? [],
})).filter((section) => section.items.length > 0);
---

<Base
  title="国内镜像源 · vansour"
  description="各语言与系统包管理器的国内镜像源，附可直接粘贴的配置命令。"
>
  <h1>国内镜像源</h1>
  <p class="lede">
    每个工具给一条可直接粘贴的命令，并标出它会改哪个文件。镜像站状态会变，所以每条都注明了最后核实日期。
  </p>

  {
    docs.length === 0 ? (
      <div class="empty">
        <p>还没有收录内容。</p>
        <p class="empty__hint">
          在 <code>src/data/mirrors/</code> 下新增一个 JSON 文件即可，格式见该目录 README。
        </p>
      </div>
    ) : (
      <>
        <nav class="toc">
          {sections.map((section) => (
            <a href={`#cat-${section.key}`}>
              {section.label}
              <span class="toc__n">{section.items.length}</span>
            </a>
          ))}
        </nav>

        {sections.map((section) => (
          <section>
            <h2 class="cat__title" id={`cat-${section.key}`}>{section.label}</h2>
            {section.items.map((doc) => (
              <ToolBlock doc={doc} />
            ))}
          </section>
        ))}

        {latestVerified && (
          <p class="stamp">
            全站最近一次核实：<time datetime={latestVerified}>{latestVerified}</time>
          </p>
        )}
      </>
    )
  }
</Base>

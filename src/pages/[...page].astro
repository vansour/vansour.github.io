---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getPublishedPosts } from '../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  // 空文章时 paginate 仍返回 1 个空页，模板里显示空态
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> };
const pageTitle = page.currentPage === 1 ? undefined : `第 ${page.currentPage} 页`;
const totalPosts = page.total;
---

<BaseLayout title={pageTitle}>
  {
    page.currentPage === 1 && (
      <section class="hero">
        <h1 class="hero-title">vansour</h1>
        <p class="hero-subtitle">服务器运维与开发笔记</p>
        <div class="hero-stats">
          <span>{totalPosts} 篇文章</span>
          <span>Astro 构建</span>
          <span>mhy.im</span>
        </div>
      </section>
    )
  }
  {
    page.data.length === 0 ? (
      <p class="page-subtitle">暂无文章</p>
    ) : (
      <>
        <div class="post-list">
          {page.data.map((post) => <PostCard post={post} />)}
        </div>

        {
          page.lastPage > 1 && (
            <nav class="pagination" aria-label="分页">
              {page.url.prev ? (
                <a href={page.url.prev}>← 上一页</a>
              ) : (
                <span class="disabled">← 上一页</span>
              )}
              <span>
                第 {page.currentPage} / {page.lastPage} 页
              </span>
              {page.url.next ? (
                <a href={page.url.next}>下一页 →</a>
              ) : (
                <span class="disabled">下一页 →</span>
              )}
            </nav>
          )
        }
      </>
    )
  }
</BaseLayout>

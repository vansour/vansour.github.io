---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import ToolView from '../../components/ToolView.astro';
import { docs } from '../../data/index';

// 静态构建：每个工具一个页面。/mirrors/index/ 由索引页占用，schema 已禁止 id 取 index。
// 自带 path 的工具（如公共 DNS 的 /dns/）不属于这个板块，走 src/pages/[...path]/index.astro。
export const getStaticPaths = (() =>
  docs
    .filter((doc) => doc.path.startsWith('/mirrors/'))
    .map((doc) => ({ params: { id: doc.id }, props: { doc } }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { doc } = Astro.props;
---

<Base title={`${doc.name} 国内镜像源 · vansour`} description={doc.tagline}>
  <ToolView doc={doc} />
</Base>

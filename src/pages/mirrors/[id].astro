---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import SourcePanel from '../../components/SourcePanel.astro';
import { docs } from '../../data/index';
import { REGION, REGION_LABEL } from '../../data/schema';
import { makeSlugs } from '../../lib/slug';

// 静态构建：每个工具一个页面。/mirrors/index/ 由索引页占用，schema 已禁止 id 取 index。
export const getStaticPaths = (() =>
  docs.map((doc) => ({ params: { id: doc.id }, props: { doc } }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { doc } = Astro.props;

// slug 由「站名 + 主地址」派生：站名全中文时退回域名标签。主地址各版本相同，取第一项即可
const slugs = makeSlugs(
  doc.mirrors.map((m) => ({ name: m.station, endpoint: m.perVersion[0]?.endpoint ?? '' })),
);

// 没有 versions 的工具在解析期已被补成单项（key 为空串），所以这里不必判空
const firstVersionKey = doc.versions[0].key;
// 默认展示第一个源——JSON 里的第一条
const defaultSlug = slugs[0] ?? '';

// 来源下拉按 region 分组，组的顺序由 REGION 定义，组内保持 JSON 里的顺序
const groups = REGION.map((region) => ({
  region,
  items: doc.mirrors
    .map((mirror, i) => ({ mirror, slug: slugs[i] }))
    .filter(({ mirror }) => mirror.region === region),
})).filter((g) => g.items.length > 0);
---

<Base title={`${doc.name} 国内镜像源 · vansour`} description={doc.tagline}>
  {/* 无 JS 时把被 hidden 的非当前面板全部放开，保证每个源都可达。
      必须加 is:inline——否则 Astro 会把 <style> 当组件样式处理，
      并把里面的内容原样吐成字面量，规则根本不生效 */}
  <noscript>
    <style is:inline>.panel[hidden]{display:block !important}.pickers{display:none}</style>
  </noscript>

  <nav class="crumbs" aria-label="面包屑">
    <a href="/mirrors/">🪞 国内镜像源</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span>{doc.id}</span>
  </nav>

  <h1 class="tool-title">
    <span class="tool-title__icon" aria-hidden="true">{doc.icon}</span>{doc.name}
  </h1>

  {/* 原生 select：键盘操作、读屏、首字母跳转都由浏览器提供，不需要自定义 ARIA。
      两个下拉都是纯前端筛选，所有组合的面板都已在 HTML 里，JS 只切 hidden */}
  <div class="pickers">
    {
      doc.versions.length > 1 && (
        <label class="picker">
          <span class="picker__label">版本</span>
          <select class="picker__select" data-version-select>
            {doc.versions.map((v, i) => (
              <option value={v.key} selected={i === 0}>
                {v.label}
              </option>
            ))}
          </select>
        </label>
      )
    }
    <label class="picker">
      <span class="picker__label">来源</span>
      <select class="picker__select" data-source-select>
        {
          groups.map((g) => (
            <optgroup label={REGION_LABEL[g.region]}>
              {g.items.map(({ mirror, slug }) => (
                <option value={slug} selected={slug === defaultSlug}>
                  {mirror.station}
                </option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </label>
  </div>

  {
    doc.mirrors.map((mirror, mi) =>
      mirror.perVersion.map((set) => (
        <SourcePanel
          docId={doc.id}
          versionKey={set.versionKey}
          slug={slugs[mi]}
          variants={set.variants}
          note={mirror.note}
          status={mirror.status}
          active={set.versionKey === firstVersionKey && slugs[mi] === defaultSlug}
        />
      )),
    )
  }
</Base>

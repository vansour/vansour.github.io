---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { docs, byCategory, CATEGORY_LABEL, latestVerified } from '../../data/index';
import { CATEGORY } from '../../data/schema';

const sections = CATEGORY.map((key) => ({
  key,
  label: CATEGORY_LABEL[key],
  items: byCategory.get(key) ?? [],
})).filter((section) => section.items.length > 0);
---

<Base
  title="国内镜像源 · vansour"
  description="各语言、系统包管理器的国内镜像源，附可直接粘贴的配置命令与核实日期。"
>
  <h1>国内镜像源</h1>
  <p class="lede">
    共 {docs.length} 个工具{
      latestVerified && (
        <>
          ，数据核实于 <time datetime={latestVerified}>{latestVerified}</time>
        </>
      )
    }。
  </p>

  {
    docs.length === 0 ? (
      <div class="empty">
        <p>还没有收录内容。</p>
        <p class="empty__hint">
          在 <code>src/data/mirrors/</code> 下新增一个 JSON 文件即可，格式见该目录 README。
        </p>
      </div>
    ) : (
      sections.map((section) => (
        <section class="cat">
          <h2 class="cat__title">{section.label}</h2>
          <div class="cat__grid">
            {section.items.map((doc) => (
              <ToolCard doc={doc} />
            ))}
          </div>
        </section>
      ))
    )
  }
</Base>

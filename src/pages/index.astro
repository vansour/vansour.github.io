---
import Base from '../layouts/Base.astro';
import NavCard from '../components/NavCard.astro';
import { boards, docs } from '../data/index';

// 导航首页：一个板块一张卡片，板块清单在 src/data/index.ts 的 boards 里
const links = boards.map((board) => ({
  href: board.href,
  icon: board.icon,
  name: board.name,
  desc: board.desc,
  count: docs.filter((doc) => doc.path.startsWith(board.href)).length,
}));
---

<Base title="vansour" description="个人导航页">
  <h1 class="mb-1.5 text-[1.7rem] font-bold tracking-tight">导航</h1>
  <p class="mb-7 max-w-[42rem] text-muted">自用索引，顺手公开。</p>

  <div class="grid gap-3 sm:grid-cols-[repeat(auto-fill,minmax(16rem,1fr))]">
    {links.map((link) => <NavCard {...link} />)}
  </div>
</Base>

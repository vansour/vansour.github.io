---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllTags, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getAllTags(posts);
  return tags.map(({ tag }) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = await getPublishedPosts();
const tagged = posts.filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`标签：${tag}`} description={`包含标签「${tag}」的文章`}>
  <h1 class="page-title">#{tag}</h1>
  <p class="page-subtitle">共 {tagged.length} 篇文章</p>

  <div class="post-list">
    {tagged.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>

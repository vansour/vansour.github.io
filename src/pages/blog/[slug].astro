---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

// 上下篇导航：上一篇/下一篇 = 排序后列表中的前一篇/后一篇（排序见 lib/posts.ts）
const posts = await getPublishedPosts();
const index = posts.findIndex((p) => p.id === post.id);
const older = index >= 0 ? posts[index + 1] : undefined;
const newer = index > 0 ? posts[index - 1] : undefined;
---

<BaseLayout title={data.title} description={data.description}>
  <article>
    <header class="article-header">
      <h1>{data.title}</h1>
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="post-nav" aria-label="上下篇">
      {older ? (
        <a href={`/blog/${older.id}/`}>
          <span class="nav-label">上一篇</span>
          <span class="nav-title">{older.data.title}</span>
        </a>
      ) : (
        <span></span>
      )}
      {newer && (
        <a class="next" href={`/blog/${newer.id}/`}>
          <span class="nav-label">下一篇</span>
          <span class="nav-title">{newer.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

---
import type { ResolvedVariant } from '../data/schema';

interface Props {
  id: string;
  variant: ResolvedVariant;
}

const { id, variant } = Astro.props;
---

<div class="variant">
  {/* 装饰（语言标签、复制按钮）都在 pre 外面，不会被一起复制走。
      按钮放在这一行而不是压在 pre 上，长命令行才有完整宽度 */}
  <p class="variant__head">
    <span class="variant__lang">{variant.lang}</span>
    <span class="variant__label">{variant.label}</span>
    <button type="button" class="cmd__copy" data-copy-target={id}>复制</button>
  </p>

  {variant.note && <p class="note">{variant.note}</p>}

  {/* pre 与 code 之间不能有换行，否则复制出的文本会带多余空白 */}
  <div class="cmd">
    <pre
      id={id}
      class:list={variant.code.includes('\n') ? 'pre--block' : ''}><code>{variant.code}</code></pre>
  </div>
</div>

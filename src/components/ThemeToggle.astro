---
// 主题面板：明暗切换 + 8 色强调色选择
// 选择即生效并写入 localStorage（theme / accent），与 BaseLayout 防闪烁脚本配合
---

<div class="theme-wrap">
  <button
    type="button"
    class="icon-button"
    id="theme-open"
    aria-label="主题设置"
    aria-expanded="false"
    aria-controls="theme-panel"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    ><path d="M12 22a10 10 0 1 1 10-10"></path><path d="M12 22a10 10 0 1 0 10-10"></path><circle cx="12" cy="12" r="3"></circle><circle cx="12" cy="5" r="0.5" fill="currentColor"></circle><circle cx="12" cy="19" r="0.5" fill="currentColor"></circle><circle cx="5" cy="12" r="0.5" fill="currentColor"></circle><circle cx="19" cy="12" r="0.5" fill="currentColor"></circle></svg>
  </button>

  <div class="theme-panel" id="theme-panel" hidden>
    <div class="theme-row">
      <span class="theme-label">明暗</span>
      <button type="button" class="theme-chip" data-mode="light">亮</button>
      <button type="button" class="theme-chip" data-mode="dark">暗</button>
    </div>
    <div class="theme-row">
      <span class="theme-label">颜色</span>
      <button type="button" class="theme-swatch" data-color="blue" aria-label="蓝色"></button>
      <button type="button" class="theme-swatch" data-color="green" aria-label="绿色"></button>
      <button type="button" class="theme-swatch" data-color="purple" aria-label="紫色"></button>
      <button type="button" class="theme-swatch" data-color="red" aria-label="红色"></button>
      <button type="button" class="theme-swatch" data-color="orange" aria-label="橙色"></button>
      <button type="button" class="theme-swatch" data-color="cyan" aria-label="青色"></button>
      <button type="button" class="theme-swatch" data-color="pink" aria-label="粉色"></button>
      <button type="button" class="theme-swatch" data-color="gray" aria-label="灰色"></button>
    </div>
  </div>
</div>

<script>
  const open = document.querySelector<HTMLButtonElement>('#theme-open');
  const panel = document.querySelector<HTMLElement>('#theme-panel');
  const root = document.documentElement;
  const ACCENTS = ['blue', 'green', 'purple', 'red', 'orange', 'cyan', 'pink', 'gray'] as const;

  // 隐私模式（Safari 严格）下 localStorage 写入会抛 QuotaExceededError/SecurityError；
  // 选择仅生效于本次会话，不持久化
  function savePreference(key: string, value: string) {
    try {
      localStorage.setItem(key, value);
    } catch {
      // 存储不可用：忽略
    }
  }

  type Accent = (typeof ACCENTS)[number];

  function isAccent(value: string | undefined): value is Accent {
    return ACCENTS.some((accent) => accent === value);
  }

  if (open && panel) {
    const themeOpen = open;
    const themePanel = panel;

    function sync() {
      const mode = root.dataset.theme ?? 'light';
      themePanel.querySelectorAll<HTMLButtonElement>('.theme-chip').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.mode === mode));
      });
      const accent = isAccent(root.dataset.accent) ? root.dataset.accent : 'blue';
      themePanel.querySelectorAll<HTMLButtonElement>('.theme-swatch').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.color === accent));
      });
    }

    themeOpen.addEventListener('click', () => {
      const show = themePanel.hidden;
      themePanel.hidden = !show;
      themeOpen.setAttribute('aria-expanded', String(show));
      if (show) sync();
    });

    themePanel.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const chip = target.closest<HTMLButtonElement>('.theme-chip');
      const mode = chip?.dataset.mode;
      if (mode === 'light' || mode === 'dark') {
        root.dataset.theme = mode;
        savePreference('theme', mode);
        sync();
        return;
      }

      const swatch = target.closest<HTMLButtonElement>('.theme-swatch');
      const color = swatch?.dataset.color;
      if (isAccent(color)) {
        root.dataset.accent = color;
        savePreference('accent', color);
        sync();
      }
    });

    // Esc 或点击面板外关闭
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !themePanel.hidden) {
        themePanel.hidden = true;
        themeOpen.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', (event) => {
      if (
        event.target instanceof Element &&
        !event.target.closest('.theme-wrap') &&
        !themePanel.hidden
      ) {
        themePanel.hidden = true;
        themeOpen.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

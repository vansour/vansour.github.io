---
import CodeBlock from './CodeBlock.astro';
import type { MirrorEntry, ResolvedVariant } from '../data/schema';

interface Props {
  docId: string;
  /** 该面板属于哪个版本；无版本的工具为空串 */
  versionKey: string;
  /** 源在工具内的 slug，由 makeSlugs() 在渲染期派生 */
  slug: string;
  variants: ResolvedVariant[];
  /** 该源自己的提醒。只有这条源有才渲染 */
  note?: string;
  /** 已停用的源整体淡化。状态标签本身不展示了，所以 dead/degraded 必须靠 note 说明 */
  status: MirrorEntry['status'];
  active: boolean;
}

const { docId, versionKey, slug, variants, note, status, active } = Astro.props;

// 命令块的 DOM id。版本必须进去——否则同一源在 12 与 13 下的 id 会完全相同，
// getElementById 只返回第一个，复制按钮会复制到另一个版本的命令。
const blockId = (variantKey: string): string =>
  [docId, versionKey, slug, variantKey].filter(Boolean).join('-');

// 状态只剩「整体淡化」这一处痕迹。必须是查表，不能用 `panel--${status}` 这种插值——
// Tailwind 扫描源码找类名，拼出来的类名它看不见，样式会静默不生成。
const TONE: Record<MirrorEntry['status'], string> = {
  ok: '',
  degraded: 'opacity-70',
  dead: 'opacity-70',
};
---

<div
  class:list={['mb-3 rounded-card border border-line bg-surface p-4 shadow-card', TONE[status]]}
  data-panel
  {/* 无版本的工具不写这个属性，而不是写一个空值——脚本那边用 `?? ''` 兜底 */}
  data-version={versionKey || undefined}
  data-slug={slug}
  hidden={!active}
>
  <div class="space-y-4">
    {note && <p class="border-l-2 border-line pl-2.5 text-[0.82rem] text-muted">{note}</p>}
    {variants.map((v) => <CodeBlock id={blockId(v.key)} variant={v} />)}
  </div>
</div>

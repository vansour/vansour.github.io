---
// 站内搜索弹窗：懒加载 Pagefind 索引（构建时生成），Ctrl+K / `/` 或导航栏图标唤起
---

<div id="search-dialog" class="search-backdrop" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="search-input-row">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
      <input
        id="search-input"
        class="search-input"
        type="search"
        placeholder="搜索文章…"
        autocomplete="off"
        spellcheck="false"
      />
      <span class="kbd-hint">Esc</span>
    </div>
    <div id="search-results" class="search-results"></div>
  </div>
</div>

<script>
  interface PagefindResult {
    data(): Promise<{
      url: string;
      title?: string;
      meta?: { title?: string };
      excerpt?: string;
    }>;
  }

  interface PagefindModule {
    search(query: string): Promise<{ results?: PagefindResult[] }>;
  }

  const dialog = document.querySelector<HTMLElement>('#search-dialog');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const resultsEl = document.querySelector<HTMLElement>('#search-results');
  const pagefindModulePath = '/pagefind/pagefind.js';

  // 懒加载的 Pagefind 模块；开发环境没有构建索引时保持 null。
  let pagefind: PagefindModule | null = null;
  let searchTimer: number | undefined;

  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = (await import(/* @vite-ignore */ pagefindModulePath)) as PagefindModule;
      return pagefind;
    } catch {
      return null;
    }
  }

  function open() {
    if (!dialog) return;
    dialog.hidden = false;
    if (input) {
      input.value = '';
      input.focus();
    }
    if (resultsEl) resultsEl.innerHTML = '';
  }

  function close() {
    if (dialog) dialog.hidden = true;
    // 失焦，否则按 / 会因「输入中」守卫而无法再次唤起
    input?.blur();
  }

  function escapeHtml(value: unknown): string {
    const escaped = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    } as const;
    return String(value).replace(/[&<>"']/g, (character) => escaped[character as keyof typeof escaped]);
  }

  async function runSearch(query: string) {
    if (!resultsEl) return;
    const trimmed = query.trim();
    if (!trimmed) {
      resultsEl.innerHTML = '';
      return;
    }

    const pf = await loadPagefind();
    if (!pf) {
      resultsEl.innerHTML =
        '<div class="search-empty">搜索索引尚未构建，请先运行 <code>npm run build</code>（生产环境自动可用）</div>';
      return;
    }

    const search = await pf.search(trimmed);
    const items = search?.results ?? [];
    if (items.length === 0) {
      resultsEl.innerHTML = '<div class="search-empty">没有找到相关文章</div>';
      return;
    }

    const html: string[] = [];
    for (const item of items.slice(0, 10)) {
      const data = await item.data();
      // 标题在 meta.title（pagefind 1.5 结构），url/title 需转义；excerpt 自带 <mark> 标签所以不转义
      const title = data.meta?.title ?? data.title ?? '';
      html.push(`
        <a class="search-result" href="${escapeHtml(data.url)}">
          <h4>${escapeHtml(title)}</h4>
          <p>${data.excerpt ?? ''}</p>
        </a>`);
    }
    resultsEl.innerHTML = html.join('');
  }

  if (input) {
    input.addEventListener('input', () => {
      if (searchTimer !== undefined) window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => void runSearch(input.value), 150);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }

  // 点击遮罩（面板外）关闭
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });

  // 打开入口：导航栏搜索图标
  document.getElementById('search-open')?.addEventListener('click', open);

  // 快捷键：Ctrl/Cmd+K 或 `/`（输入框内除外）
  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const typing =
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      (target instanceof HTMLElement && target.isContentEditable);

    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      open();
    } else if (event.key === '/' && !typing && dialog?.hidden) {
      event.preventDefault();
      open();
    } else if (event.key === 'Escape' && !dialog?.hidden) {
      close();
    }
  });
</script>

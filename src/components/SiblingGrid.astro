---
import type { MirrorDoc } from '../data/schema';

interface Props {
  docs: MirrorDoc[];
  /** 当前工具，不出现在「其他工具」里 */
  currentId: string;
}

const { docs, currentId } = Astro.props;
const others = docs.filter((d) => d.id !== currentId);
---

{
  others.length > 0 && (
    <section class="siblings">
      <h2 class="siblings__title">其他工具镜像源</h2>
      <div class="siblings__grid">
        {others.map((d) => (
          <a class="sibling" href={`/mirrors/${d.id}/`}>
            <span class="sibling__icon" aria-hidden="true">{d.icon}</span>
            <span class="sibling__text">
              <span class="sibling__name">{d.name}</span>
              <span class="sibling__tagline">{d.tagline}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}

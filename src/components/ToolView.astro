---
import SourcePanel from './SourcePanel.astro';
import type { MirrorDoc } from '../data/schema';
import { REGION, REGION_LABEL } from '../data/schema';
import { makeSlugs } from '../lib/slug';

interface Props {
  doc: MirrorDoc;
}

const { doc } = Astro.props;

// slug 由「站名 + 主地址」派生：站名全中文时退回域名标签。主地址各版本相同，取第一项即可
const slugs = makeSlugs(
  doc.mirrors.map((m) => ({ name: m.station, endpoint: m.perVersion[0]?.endpoint ?? '' })),
);

// 没有 versions 的工具在解析期已被补成单项（key 为空串），所以这里不必判空
const firstVersionKey = doc.versions[0].key;
// 默认展示第一个源——JSON 里的第一条
const defaultSlug = slugs[0] ?? '';

// 来源下拉按 region 分组，组的顺序由 REGION 定义，组内保持 JSON 里的顺序
const groups = REGION.map((region) => ({
  region,
  items: doc.mirrors
    .map((mirror, i) => ({ mirror, slug: slugs[i] }))
    .filter(({ mirror }) => mirror.region === region),
})).filter((g) => g.items.length > 0);

const selectClass =
  'cursor-pointer rounded-ctl border border-line bg-surface px-2 py-1 text-[0.83rem] text-ink transition-colors hover:border-sky';
---

{/* 无 JS 时把被 hidden 的非当前面板全部放开，保证每个源都可达。
    选择器用的是契约属性（data-panel / data-pickers）而不是类名，类名改了这里不会失效。

    两条规则必须分属不同层，否则会静默失效（都踩过）：
    · [data-pickers] 无层——正常声明里「无层」优先于任何 @layer，才压得住
      工具类给的 display:flex；
    · [data-panel][hidden] 必须进 @layer base——preflight 的
      `[hidden]:where(...){display:none !important}` 带 !important，而**对 !important
      声明层序先于特指度**：进不了同一层，特指度再高也赢不了。同层之内才是比特指度，
      我们多一个 [data-panel]，赢。

    必须加 is:inline——否则 Astro 会把 <style> 当组件样式处理，
    并把里面的内容原样吐成字面量，规则根本不生效 */}
<noscript>
  <style is:inline>[data-pickers]{display:none}@layer base{[data-panel][hidden]{display:block !important}}</style>
</noscript>

<h1 class="mb-1.5 flex items-center gap-2.5 text-[1.7rem] font-bold tracking-tight">
  <span aria-hidden="true">{doc.icon}</span>{doc.name}
</h1>
<p class="mb-6 max-w-[42rem] text-muted">{doc.tagline}</p>

{/* 原生 select：键盘操作、读屏、首字母跳转都由浏览器提供，不需要自定义 ARIA。
    两个下拉都是纯前端筛选，所有组合的面板都已在 HTML 里，JS 只切 hidden */}
<div class="mb-5 flex flex-wrap gap-x-5 gap-y-3" data-pickers>
  {
    doc.versions.length > 1 && (
      <label class="flex min-w-0 items-center gap-2">
        <span class="text-[0.83rem] text-muted">版本</span>
        <select class={selectClass} data-version-select>
          {doc.versions.map((v, i) => (
            <option value={v.key} selected={i === 0}>
              {v.label}
            </option>
          ))}
        </select>
      </label>
    )
  }
  <label class="flex min-w-0 items-center gap-2">
    <span class="text-[0.83rem] text-muted">来源</span>
    <select class={selectClass} data-source-select>
      {
        groups.map((g) => (
          <optgroup label={REGION_LABEL[g.region]}>
            {g.items.map(({ mirror, slug }) => (
              <option value={slug} selected={slug === defaultSlug}>
                {mirror.station}
              </option>
            ))}
          </optgroup>
        ))
      }
    </select>
  </label>
</div>

{
  doc.mirrors.map((mirror, mi) =>
    mirror.perVersion.map((set) => (
      <SourcePanel
        docId={doc.id}
        versionKey={set.versionKey}
        slug={slugs[mi]}
        variants={set.variants}
        status={mirror.status}
        active={set.versionKey === firstVersionKey && slugs[mi] === defaultSlug}
      />
    )),
  )
}

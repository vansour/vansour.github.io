---
import type { MirrorDoc } from '../data/schema';
import { STATUS_LABEL } from '../data/schema';

interface Props {
  doc: MirrorDoc;
}

const { doc } = Astro.props;

// 超过这个行数的命令块限制高度、允许内部滚动。
// 长配置（如 Debian 的 deb822）若不设上限，十几个源叠加会把页面撑到无法浏览。
// 复制取的是 textContent，不受滚动影响，仍是全文。
const TALL_LINES = 14;
---

<article class="tool" id={doc.id}>
  <header class="tool__head">
    <h3 class="tool__name">{doc.name}</h3>
    <p class="tool__file">修改 <code>{doc.modified_file}</code></p>
  </header>

  {doc.note && <p class="tool__note">{doc.note}</p>}

  {
    doc.mirrors.map((mirror, index) => (
      <div class={`row row--${mirror.status}`}>
        <p class="row__meta">
          <span class={`dot dot--${mirror.status}`} aria-hidden="true" />
          <span class="station">{mirror.station}</span>
          <span class={`status status--${mirror.status}`}>
            {STATUS_LABEL[mirror.status]}
          </span>
          <time class="date" datetime={mirror.verified_at}>
            {mirror.verified_at}
          </time>
        </p>

        <div class="row__body">
          <p class="endpoint">{mirror.endpoint}</p>

          {mirror.note && <p class="note">{mirror.note}</p>}

          {mirror.variants.map((v) => {
            const snippetId = `${doc.id}-${index}-${v.key}`;
            const lines = v.code.split('\n').length;
            return (
              <div class="variant">
                <p class="variant__head">
                  <span class="variant__lang">{v.lang}</span>
                  <span class="variant__label">{v.label}</span>
                </p>
                {v.note && <p class="note">{v.note}</p>}

                {/* pre 与 code 之间不能有换行，否则复制出的文本会带多余空白。
                    装饰（色条、lang 标签、按钮）都在 pre 外面，不会被复制走。 */}
                <div class="cmd">
                  <pre
                    id={snippetId}
                    class:list={[
                      v.code.includes('\n') ? 'pre--block' : '',
                      lines > TALL_LINES ? 'pre--tall' : '',
                    ]}><code>{v.code}</code></pre>
                  <button type="button" class="cmd__copy" data-copy-target={snippetId}>
                    复制
                  </button>
                </div>
              </div>
            );
          })}

          {mirror.doc && (
            <a class="doc" href={mirror.doc} target="_blank" rel="noopener noreferrer">
              官方文档 ↗
            </a>
          )}
        </div>
      </div>
    ))
  }
</article>

---
// 多变体代码框交互：选择器切换组合、输入替换和复制当前组合。
// 构建期默认输出纯文本；若未来重新启用高亮，也会在输入恢复默认时还原原始 HTML。
---

<script>
  import { copyText, codeBlockText } from '../lib/code-copy';

  function initCodeTabs() {
    document.querySelectorAll('.code-tabs').forEach((tabs) => {
      const variants = [...tabs.querySelectorAll<HTMLPreElement>('.code-variant')];
      const selects = [...tabs.querySelectorAll<HTMLSelectElement>('.ct-select')];
      const inputs = [...tabs.querySelectorAll<HTMLInputElement>('.ct-input')];

      // 记录每个变体的原始代码。文本是替换基准，HTML 用于恢复高亮或默认状态。
      const originals = new Map<HTMLPreElement, { code: HTMLElement; html: string; text: string }>();
      variants.forEach((pre) => {
        const code = pre.querySelector<HTMLElement>('code');
        if (!code) return;
        originals.set(pre, {
          code,
          html: code.innerHTML,
          text: code.textContent ?? '',
        });
      });

      const update = () => {
        const combo = selects.map((s) => s.value).join('|');
        variants.forEach((pre) => {
          pre.hidden = pre.dataset.combo !== combo;
        });
        patchInputs();
      };

      // 输入框维度：始终从原始文本开始替换，避免连续输入造成重复替换；
      // 输入恢复默认时还原原始 HTML。
      const patchInputs = () => {
        const active = variants.find((pre) => !pre.hidden);
        if (!active) return;
        const original = originals.get(active);
        if (!original) return;

        let text = original.text;
        let changed = false;
        for (const input of inputs) {
          const defaultValue = input.dataset.default ?? '';
          if (!defaultValue || input.value === defaultValue) continue;
          changed = true;
          text = text.split(defaultValue).join(input.value);
        }

        if (!changed) {
          if (original.code.innerHTML !== original.html) original.code.innerHTML = original.html;
        } else if (original.code.textContent !== text) {
          // 纯文本构建产物没有 .line；改变输入时安全地写入文本节点，避免 HTML 注入。
          original.code.textContent = text;
        }
      };

      selects.forEach((select) => {
        select.addEventListener('change', update);
      });

      inputs.forEach((input) => {
        input.addEventListener('input', patchInputs);
      });

      const copyBtn = tabs.querySelector<HTMLButtonElement>('.ct-copy');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const active = variants.find((pre) => !pre.hidden);
          if (!active) return;
          const ok = await copyText(codeBlockText(active));
          copyBtn.textContent = ok ? '已复制' : '复制失败';
          copyBtn.classList.toggle('copied', ok);
          setTimeout(() => {
            copyBtn.textContent = '复制';
            copyBtn.classList.remove('copied');
          }, 1500);
        });
      }
    });
  }

  initCodeTabs();
</script>

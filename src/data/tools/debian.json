{
  "id": "debian",
  "name": "Debian",
  "category": "system",
  "icon": "🌀",
  "tagline": "apt 源，安全更新分属两个地址",
  "modified_file": "/etc/apt/sources.list.d/debian.sources",
  "endpoint_var": "deb",
  "var_defaults": {
    "sec": "{deb}-security"
  },
  "versions": [
    {
      "key": "13",
      "label": "13 (trixie)",
      "vars": {
        "suite": "trixie"
      }
    },
    {
      "key": "12",
      "label": "12 (bookworm)",
      "vars": {
        "suite": "bookworm"
      }
    }
  ],
  "variants": [
    {
      "key": "clear",
      "lang": "bash",
      "label": "清空旧配置",
      "code": "sudo rm -rf /etc/apt/mirrors \\\n            /etc/apt/sources.list.d/* \\\n            /etc/apt/sources.list"
    },
    {
      "key": "sources",
      "lang": "bash",
      "label": "写入 deb822 源文件",
      "code": "sudo tee /etc/apt/sources.list.d/debian.sources > /dev/null <<'EOF'\nTypes: deb\nURIs: {deb}\nSuites: {suite} {suite}-updates {suite}-backports\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb-src\nURIs: {deb}\nSuites: {suite} {suite}-updates {suite}-backports\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: {sec}\nSuites: {suite}-security\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb-src\nURIs: {sec}\nSuites: {suite}-security\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\nEOF\nsudo apt update"
    }
  ],
  "mirrors": [

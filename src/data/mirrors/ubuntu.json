{
  "id": "ubuntu",
  "name": "Ubuntu 26.04 LTS (resolute)",
  "category": "system",
  "icon": "🟠",
  "tagline": "apt 的 deb822 源配置，安全更新与主归档同路径",
  "modified_file": "/etc/apt/sources.list.d/ubuntu.sources",
  "endpoint_var": "main",
  "var_defaults": {
    "sec": "{main}"
  },
  "variants": [
    {
      "key": "sources",
      "lang": "bash",
      "label": "写入 deb822 源文件",
      "code": "sudo tee /etc/apt/sources.list.d/ubuntu.sources > /dev/null <<'EOF'\nTypes: deb\nURIs: {main}\nSuites: resolute resolute-updates resolute-backports\nComponents: main restricted universe multiverse\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n\nTypes: deb-src\nURIs: {main}\nSuites: resolute resolute-updates resolute-backports\nComponents: main restricted universe multiverse\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n\nTypes: deb\nURIs: {sec}\nSuites: resolute-security\nComponents: main restricted universe multiverse\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n\nTypes: deb-src\nURIs: {sec}\nSuites: resolute-security\nComponents: main restricted universe multiverse\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\nEOF\nsudo apt update"
    }
  ],

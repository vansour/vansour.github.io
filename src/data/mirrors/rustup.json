{
  "id": "rustup",
  "name": "rustup",
  "category": "language",
  "icon": "🦀",
  "tagline": "Rust 工具链的下载源",
  "modified_file": "环境变量 RUSTUP_DIST_SERVER / RUSTUP_UPDATE_ROOT（写进 shell 配置则长期生效）",
  "endpoint_var": "dist",
  "var_defaults": {
    "update": "{dist}/rustup"
  },
  "variants": [
    {
      "key": "oneshot",
      "lang": "bash",
      "label": "只装一次",
      "code": "RUSTUP_DIST_SERVER={dist} rustup install stable",
      "note": "只影响这一条命令，重开终端就没了；要长期生效用下面那块"
    },
    {
      "key": "shellrc",
      "lang": "bash",
      "label": "写进 shell 配置（长期生效）",
      "code": "echo 'export RUSTUP_DIST_SERVER={dist}' >> ~/.bashrc\necho 'export RUSTUP_UPDATE_ROOT={update}' >> ~/.bashrc",
      "note": "只写配置，对之后打开的终端生效；zsh 用户把 ~/.bashrc 换成 ~/.zshrc。重复执行会追加重复行，值相同、无害"
    }
  ],

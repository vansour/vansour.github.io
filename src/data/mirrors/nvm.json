  "modified_file": "环境变量 NVM_NODEJS_ORG_MIRROR（写进 shell 配置则长期生效）",
  "endpoint_var": "url",
  "variants": [
    {
      "key": "session",
      "lang": "bash",
      "label": "当前 shell 生效",
      "code": "export NVM_NODEJS_ORG_MIRROR={url}\nnvm install --lts",
      "note": "只在当前 shell 生效，重开终端就没了；要长期生效用下面那块"
    },
    {
      "key": "shellrc",
      "lang": "bash",
      "label": "写进 shell 配置（长期生效）",
      "code": "echo 'export NVM_NODEJS_ORG_MIRROR={url}' >> ~/.bashrc",
      "note": "只写配置，对之后打开的终端生效；zsh 用户把 ~/.bashrc 换成 ~/.zshrc。重复执行会追加重复行，值相同、无害"
    }
  ],

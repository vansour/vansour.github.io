{
  "id": "debian",
  "name": "Debian 13 (trixie)",
  "category": "system",
  "icon": "🌀",
  "tagline": "apt 源，安全更新分属两个地址",
  "modified_file": "/etc/apt/sources.list.d/debian.sources",
  "endpoint_var": "deb",
  "var_defaults": {
    "sec": "{deb}-security"
  },
  "variants": [
    {
      "key": "sources",
      "lang": "bash",
      "label": "写入 deb822 源文件",
      "code": "sudo tee /etc/apt/sources.list.d/debian.sources > /dev/null <<'EOF'\nTypes: deb\nURIs: {deb}\nSuites: trixie trixie-updates trixie-backports\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb-src\nURIs: {deb}\nSuites: trixie trixie-updates trixie-backports\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: {sec}\nSuites: trixie-security\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb-src\nURIs: {sec}\nSuites: trixie-security\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\nEOF\nsudo apt update"
    }
  ],
